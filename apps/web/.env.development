# Used by `npm run dev`. With VITE_USE_EMULATORS=true the app talks only to the local
# emulators and the values below can stay as they are.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-site-streak
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=demo-site-streak.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
